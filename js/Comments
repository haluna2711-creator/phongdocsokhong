const { getSupabaseAdmin } = require('./_lib/supabaseAdmin');

function mapRow(r) {
  return {
    id: r.id,
    postUrl: r.post_url,
    postTitle: r.post_title,
    name: r.name,
    body: r.body,
    ts: Number(r.ts),
    parentId: r.parent_id || null,
    isAdmin: !!r.is_admin,
  };
}

module.exports = async function handler(req, res) {
  const db = getSupabaseAdmin();

  if (req.method === 'GET') {
    const postUrl = String(req.query.postUrl || '').trim();
    if (!postUrl) return res.status(400).json({ ok: false, reason: 'missing_postUrl' });

    const { data, error } = await db
      .from('comments')
      .select('id, post_url, post_title, name, body, ts, parent_id, is_admin')
      .eq('post_url', postUrl)
      .eq('deleted', false)
      .order('ts', { ascending: true });

    if (error) return res.status(500).json({ ok: false, reason: error.message });
    return res.status(200).json({ ok: true, data: (data || []).map(mapRow) });
  }

  if (req.method === 'POST') {
    const b = req.body || {};
    const postUrl = String(b.postUrl || '').trim();
    const postTitle = String(b.postTitle || '').trim();
    const name = String(b.name || '').trim().slice(0, 60);
    const body = String(b.body || '').trim().slice(0, 2000);
    const parentId = b.parentId ? String(b.parentId) : null;

    if (!postUrl || !name || !body) {
      return res.status(400).json({ ok: false, reason: 'missing_fields' });
    }

    const { data, error } = await db
      .from('comments')
      .insert({
        post_url: postUrl,
        post_title: postTitle || null,
        name,
        body,
        ts: Date.now(),
        parent_id: parentId,
        is_admin: false,
        deleted: false,
      })
      .select('id')
      .single();

    if (error) return res.status(500).json({ ok: false, reason: error.message });
    return res.status(200).json({ ok: true, id: data.id });
  }

  return res.status(405).json({ ok: false, reason: 'method_not_allowed' });
};
