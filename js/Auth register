// PHÒNG ĐỌC SỐ 0 — Auth gate (Supabase + Apps Script chỉ để gửi mail)
// Dữ liệu email/mã truy cập lưu ở Supabase (bảng "readers").
// Việc GỬI EMAIL vẫn nhờ Google Apps Script (gas/MailSender.gs) vì Vercel
// không tự gửi email được — script đó KHÔNG lưu dữ liệu gì cả.
//
// Biến môi trường cần thiết trên Vercel:
//   MAIL_SENDER_URL — URL /exec của gas/MailSender.gs
//   MAIL_SENDER_KEY — phải trùng Script Property "MAIL_KEY" của script đó
// ════════════════════════════════════

const { getSupabaseAdmin } = require('./_lib/supabaseAdmin');
const { fetchJsonWithTimeout } = require('./_lib/httpFetch');

// Ký tự dễ đọc, bỏ các ký tự dễ nhầm lẫn (0/O, 1/I/L)
const CODE_CHARS = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';

function generateCode(len = 6) {
  let out = '';
  for (let i = 0; i < len; i++) {
    out += CODE_CHARS[Math.floor(Math.random() * CODE_CHARS.length)];
  }
  return out;
}

async function sendCodeEmail(email, code) {
  const base = process.env.MAIL_SENDER_URL;
  const key = process.env.MAIL_SENDER_KEY;
  if (!base || !key) throw new Error('Thiếu biến môi trường MAIL_SENDER_URL hoặc MAIL_SENDER_KEY.');
  const qs = new URLSearchParams({ action: 'sendCode', key, email, code });
  const data = await fetchJsonWithTimeout(`${base}?${qs.toString()}`);
  if (!data.ok) throw new Error(data.error || 'mail_send_failed');
}

module.exports = async function handler(req, res) {
  const db = getSupabaseAdmin();
  const action = String(req.query.action || '').trim();
  const email = String(req.query.email || '').trim().toLowerCase();

  if (!email || email.indexOf('@') < 1) {
    return res.status(200).json({ ok: false, reason: 'invalid_email' });
  }

  if (action === 'register') {
    const { data: existing, error: selErr } = await db
      .from('readers').select('id, disabled, access_code').eq('email', email).maybeSingle();
    if (selErr) return res.status(500).json({ ok: false, reason: selErr.message });

    if (existing) {
      if (existing.disabled) return res.status(200).json({ ok: false, reason: 'account_disabled' });
      // Đã có mã từ trước — gửi lại email với mã cũ (tiện cho người lỡ mất email đầu tiên)
      try { await sendCodeEmail(email, existing.access_code); } catch (e) { console.error('resend mail failed', e); }
      return res.status(200).json({ ok: false, reason: 'already_registered' });
    }

    const code = generateCode();
    const { error: insErr } = await db.from('readers').insert({ email, access_code: code, disabled: false });
    if (insErr) return res.status(500).json({ ok: false, reason: insErr.message });

    try {
      await sendCodeEmail(email, code);
    } catch (e) {
      // Dữ liệu đã lưu — người dùng có thể bấm "Nhận mã" lần nữa để được gửi lại mail.
      return res.status(200).json({ ok: false, reason: 'mail_send_failed' });
    }
    return res.status(200).json({ ok: true });
  }

  if (action === 'verify') {
    const code = String(req.query.code || '').trim().toUpperCase();
    if (!code) return res.status(200).json({ ok: false, reason: 'missing_code' });

    const { data: reader, error } = await db
      .from('readers').select('access_code, disabled').eq('email', email).maybeSingle();
    if (error) return res.status(500).json({ ok: false, reason: error.message });
    if (!reader) return res.status(200).json({ ok: false, reason: 'email_not_found' });
    if (reader.disabled) return res.status(200).json({ ok: false, reason: 'account_disabled' });
    if (reader.access_code.toUpperCase() !== code) return res.status(200).json({ ok: false, reason: 'wrong_code' });

    return res.status(200).json({ ok: true });
  }

  return res.status(400).json({ ok: false, reason: 'unknown_action' });
};
