@@ -19,14 +19,40 @@ function gasUrl(action, params) {
   return `${base}?${qs.toString()}`;
 }
 
+// Google Apps Script đôi khi bị "cold start" hoặc treo lâu bất thường.
+// Nếu không giới hạn thời gian, request có thể treo tới khi Vercel tự
+// timeout function (không có thông báo lỗi rõ ràng, admin thấy trang
+// "không hiển thị gì"). Đặt timeout ngắn hơn để luôn trả lỗi rõ ràng.
+async function fetchGas(url, timeoutMs = 9000) {
+  const controller = new AbortController();
+  const t = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const r = await fetch(url, { signal: controller.signal });
+    const text = await r.text();
+    try {
+      return JSON.parse(text);
+    } catch (_) {
+      // GAS trả về không phải JSON — thường là do deployment sai quyền
+      // ("Who has access" khác "Anyone") nên Google trả về trang đăng nhập HTML.
+      throw new Error('Apps Script không trả về JSON hợp lệ (kiểm tra lại quyền truy cập của deployment).');
+    }
+  } catch (err) {
+    if (err.name === 'AbortError') {
+      throw new Error('Apps Script phản hồi quá chậm (quá ' + Math.round(timeoutMs / 1000) + 's).');
+    }
+    throw err;
+  } finally {
+    clearTimeout(t);
+  }
+}
