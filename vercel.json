{
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/post/:slug",            "destination": "/post.html" },
    { "source": "/doc/:novel/:chapter",   "destination": "/doc.html" },
    { "source": "/p/:slug",               "destination": "/pages/:slug.html" },
    { "source": "/admin",                 "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
     }
    {
  "source": "/logo-ngang.png",
  "headers": [
    { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
  ]
}
  ],
  "crons": [
  { "path": "/api/cron-publish", "schedule": "0 10 * * *" },
  { "path": "/api/cron-lock-inactive", "schedule": "0 3 * * *" }
]
}
