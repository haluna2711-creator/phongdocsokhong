<style>
#starsCanvas{
  position:fixed;inset:0;width:100%;height:100%;
  pointer-events:none;z-index:0;opacity:0.7;
  transform:translateZ(0);
}

.tagpage-wrap{position:relative;z-index:1;max-width:1300px;margin:0 auto;padding:0 28px 100px}

.tagpage-hero{padding:64px 0 50px;text-align:center;position:relative}
.tagpage-eyebrow{font-family:'Vollkorn',serif;font-size:11px;font-weight:700;letter-spacing:0.3em;text-transform:uppercase;color:var(--gold-light);opacity:0.7;margin-bottom:20px}
.tagpage-title{font-family:'Vollkorn',serif;font-size:clamp(32px,5vw,56px);font-weight:900;color:var(--gold-light);line-height:1.1;letter-spacing:0.04em;margin-bottom:8px}
.tagpage-title-sub{font-family:'Vollkorn',serif;font-size:clamp(14px,2vw,18px);font-weight:400;font-style:italic;color:var(--text-muted);margin-bottom:32px}
.tagpage-divider{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:32px}
.tagpage-divider-line{width:80px;height:1px;background:linear-gradient(to right,transparent,var(--gold-border))}
.tagpage-divider-line.right{background:linear-gradient(to left,transparent,var(--gold-border))}
.tagpage-divider-gem{color:var(--gold-light);font-size:12px;opacity:0.6}
.tagpage-desc{max-width:700px;margin:0 auto;font-size:17px;line-height:2;color:rgba(245,240,232,0.72);font-style:italic;letter-spacing:0.01em}

.tagpage-count-bar{display:flex;align-items:center;gap:20px;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid var(--gold-border)}
.tagpage-count-num{font-family:'Vollkorn',serif;font-size:28px;font-weight:700;color:var(--gold-light)}
.tagpage-count-label{font-size:13px;color:var(--text-muted)}
.tagpage-count-bar-line{flex:1;height:1px;background:linear-gradient(to right,var(--gold-border),transparent)}

.tagpage-nav{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:44px}
.tagpage-chip{
  display:inline-flex;align-items:center;gap:6px;
  padding:8px 16px;border:1px solid var(--gold-border);border-radius:999px;
  font-family:'Vollkorn',serif;font-size:12px;font-weight:600;letter-spacing:0.04em;
  color:var(--gold-light);text-decoration:none;background:var(--black-2);
  transition:background var(--transition),border-color var(--transition),transform var(--transition);
}
.tagpage-chip:hover{background:rgba(248,219,143,0.08);border-color:rgba(248,219,143,0.55);transform:translateY(-2px)}
.tagpage-chip-count{opacity:0.55;font-size:11px}

.tagpage-section{margin-bottom:56px;scroll-margin-top:100px}
.tagpage-section-head{display:flex;align-items:baseline;gap:12px;margin-bottom:22px}
.tagpage-section-title{font-family:'Vollkorn',serif;font-size:20px;font-weight:700;color:var(--gold-light);letter-spacing:0.03em}
.tagpage-section-count{font-size:12px;color:var(--text-muted);font-style:italic}
.tagpage-section-line{flex:1;height:1px;background:linear-gradient(to right,var(--gold-border),transparent)}

.tagpage-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;contain:layout style}
@media(max-width:1024px){.tagpage-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:720px){.tagpage-grid{grid-template-columns:repeat(2,1fr);gap:16px}}
@media(max-width:440px){.tagpage-grid{grid-template-columns:repeat(2,1fr);gap:12px}}

.tagpage-card{
  display:flex;flex-direction:column;background:var(--black-2);
  border:1px solid var(--gold-border);border-radius:8px;overflow:hidden;
  transition:border-color var(--transition),box-shadow var(--transition),transform var(--transition);
  cursor:pointer;contain:layout style paint;
}
.tagpage-card:hover{border-color:rgba(248,219,143,0.55);box-shadow:0 16px 48px rgba(0,0,0,0.7),0 0 0 1px rgba(248,219,143,0.18);transform:translateY(-5px)}

.tagpage-cover{position:relative;width:100%;aspect-ratio:2/3;overflow:hidden;flex-shrink:0}
.tagpage-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.5s ease;content-visibility:auto}
.tagpage-card:hover .tagpage-cover img{transform:scale(1.05)}
.tagpage-cover-ph{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:linear-gradient(145deg,var(--black-3) 0%,var(--black-4) 100%);color:var(--gold-border);font-size:12px;text-align:center;padding:16px}
.tagpage-cover-overlay{position:absolute;inset:0;background:rgba(10,10,10,0.8);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity var(--transition);pointer-events:none}
