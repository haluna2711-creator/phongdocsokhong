<script>
// ════════════════════════════════════
// Stars Canvas — nền riêng cho trang Tất Cả Thể Loại (copy y hệt trang
// Quỹ Đạo Luân Chuyển để giữ đồng bộ cảm giác thị giác giữa các trang phụ)
// ════════════════════════════════════
(function(){
  const c   = document.getElementById('starsCanvas');
  const ctx = c.getContext('2d', { alpha: true, desynchronized: true });

  let stars = [], raf, W, H;
  const isMobile = window.innerWidth < 721;
  const DENSITY = isMobile ? 0.12 : 0.3;

  function resize(){ W = c.width = window.innerWidth; H = c.height = window.innerHeight; buildStars(); }
  function buildStars(){
    const n = Math.floor(W * DENSITY);
    stars = new Array(n);
    for(let i = 0; i < n; i++){
      stars[i] = { x: Math.random()*W, y: Math.random()*H, r: Math.random()*1.4+0.3, a: Math.random()*0.8+0.2, phase: Math.random()*6.28318, speed: Math.random()*0.012+0.005, gold: Math.random() > 0.45 };
    }
  }
  let lastFrameTime = 0;
  const TARGET_FPS = isMobile ? 30 : 60;
  const FRAME_MS = 1000 / TARGET_FPS;
  function draw(now){
    raf = requestAnimationFrame(draw);
    if(now - lastFrameTime < FRAME_MS) return;
    lastFrameTime = now;
    ctx.clearRect(0,0,W,H);
    for(let i=0;i<stars.length;i++){ const s=stars[i]; if(!s.gold) continue; s.phase+=s.speed; ctx.globalAlpha = s.a*(0.5+0.5*Math.sin(s.phase)); ctx.fillStyle='rgba(248,219,143,1)'; ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,6.28318); ctx.fill(); }
    for(let i=0;i<stars.length;i++){ const s=stars[i]; if(s.gold) continue; s.phase+=s.speed; ctx.globalAlpha = s.a*(0.5+0.5*Math.sin(s.phase)); ctx.fillStyle='rgba(200,168,75,1)'; ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,6.28318); ctx.fill(); }
    ctx.globalAlpha = 1;
  }
  document.addEventListener('visibilitychange', () => {
    if(document.hidden){ cancelAnimationFrame(raf); } else { lastFrameTime = 0; raf = requestAnimationFrame(draw); }
  });
  let resizeTimer;
  window.addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(resize, 200); });
  resize();
  raf = requestAnimationFrame(draw);
})();

// ════════════════════════════════════
// DANH SÁCH TOÀN BỘ THỂ LOẠI + TOÀN BỘ TRUYỆN — lấy từ /api/novels (đã có
// sẵn, public, tự lọc published=true). Phạm vi giống trang chủ: chỉ truyện
// có gắn nhãn "Đam Mỹ" mới được đưa vào đây, nhóm theo thể loại còn lại.
// ════════════════════════════════════
const TAG_GENRE_MAP = {
  'Trinh thám': 'Trinh thám',
  'Vô hạn lưu': 'Vô hạn lưu',
  'Cổ đại':     'Cổ đại',
  'Kinh dị':    'Kinh dị',
  'Hệ thống':   'Hệ thống',
};
const TAG_DAM_MY_SLUG = 'dam-my';

const TAG_ICON_ARROW = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;
const TAG_ICON_EYE   = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg>`;
const TAG_ICON_BOOK  = `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`;
const TAG_ICON_OPEN  = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`;

function tagFormatNum(n){
  return (n || 0).toLocaleString('vi-VN');
}

function tagSlugify(s){
  return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
}

function tagParseNovel(novel){
  const labels     = novel.novel_labels || [];
  const labelSlugs = labels.map(nl => nl.labels?.slug).filter(Boolean);
  const labelNames = labels.map(nl => nl.labels?.name).filter(Boolean);

  if(!labelSlugs.includes(TAG_DAM_MY_SLUG)) return null;

  const genreLabels = labelNames.filter((_, i) => labelSlugs[i] !== TAG_DAM_MY_SLUG);
  const genre = genreLabels.find(l => TAG_GENRE_MAP[l]) || genreLabels[0] || 'Khác';
  const bg = (window.PDS_CONFIG && PDS_CONFIG.GENRE_BG && PDS_CONFIG.GENRE_BG[genre]) || (window.PDS_CONFIG && PDS_CONFIG.GENRE_BG['default']) || 'linear-gradient(145deg,#111111,#1a1a1a)';

  return {
    title: novel.title || 'Không có tiêu đề',
    genre, bg,
    cover: novel.cover_url || '',
    readUrl: `/post/${novel.slug}`,
    desc: (novel.description || '').slice(0, 160),
    chapter: novel.chapter_count ? `Ch.${novel.chapter_count}` : '',
    viewsTotal: novel.view_count_total || 0,
  };
}

function tagBuildCard(story, index){
  const hasImg = !!story.cover;
  const loadAttr = index < 8 ? 'loading="eager" fetchpriority="high"' : 'loading="lazy" decoding="async"';
  const card = document.createElement('div');
  card.className = 'tagpage-card';
  card.innerHTML =
    `<div class="tagpage-cover">` +
    (hasImg ? `<img src="${story.cover}" alt="${story.title}" ${loadAttr} onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">` : '') +
    `<div class="tagpage-cover-ph" style="background:${story.bg};${hasImg?'display:none':''}">${TAG_ICON_BOOK}<span style="font-size:11px;line-height:1.4;opacity:0.7">${story.title}</span></div>
     <div class="tagpage-cover-overlay"><a class="tagpage-btn-read" href="${story.readUrl}">${TAG_ICON_ARROW}ĐỌC NGAY</a></div>
    </div>
    <div class="tagpage-body">
      <div class="tagpage-title-txt">${story.title}</div>
      <div class="tagpage-card-divider"></div>
      ${story.desc ? `<div class="tagpage-desc-txt">${story.desc}</div>` : ''}
      <div class="tagpage-meta">${TAG_ICON_EYE}<span>${tagFormatNum(story.viewsTotal)} lượt đọc${story.chapter ? ' · '+story.chapter : ''}</span></div>
      <div class="tagpage-btn-row"><a class="tagpage-read-btn" href="${story.readUrl}">${TAG_ICON_OPEN}Đọc Truyện</a></div>
    </div>`;
  return card;
}

function tagRenderSections(stories){
  const sectionsWrap = document.getElementById('tagpageSections');
  const navWrap      = document.getElementById('tagpageNav');
  const countBar      = document.getElementById('tagpageCountBar');
  const countNum       = document.getElementById('tagpageCountNum');
  const genreNum        = document.getElementById('tagpageGenreNum');

  if(!stories.length){ tagShowEmpty(); return; }

  const groups = {};
  stories.forEach(s => { (groups[s.genre] = groups[s.genre] || []).push(s); });
  const genres = Object.keys(groups).sort((a, b) => {
    const va = groups[a].reduce((sum, x) => sum + x.viewsTotal, 0);
    const vb = groups[b].reduce((sum, x) => sum + x.viewsTotal, 0);
    return vb - va;
  });

  countNum.textContent  = stories.length;
  genreNum.textContent  = genres.length;
  countBar.style.display = 'flex';

  navWrap.innerHTML = genres.map(g => {
    const id = 'tag-' + tagSlugify(g);
    return `<a class="tagpage-chip" href="#${id}">${g} <span class="tagpage-chip-count">${groups[g].length}</span></a>`;
  }).join('');

  const sectionsFrag = document.createDocumentFragment();
  genres.forEach(genre => {
    const books = groups[genre].sort((a, b) => b.viewsTotal - a.viewsTotal);
    const id = 'tag-' + tagSlugify(genre);

    const section = document.createElement('section');
    section.className = 'tagpage-section';
    section.id = id;
    section.innerHTML = `
      <div class="tagpage-section-head">
        <div class="tagpage-section-title">✦ ${genre}</div>
        <div class="tagpage-section-count">${books.length} truyện</div>
        <div class="tagpage-section-line"></div>
      </div>
      <div class="tagpage-grid"></div>`;

    const grid = section.querySelector('.tagpage-grid');
    const cardsFrag = document.createDocumentFragment();
    books.forEach((b, i) => cardsFrag.appendChild(tagBuildCard(b, i)));
    grid.appendChild(cardsFrag);

    sectionsFrag.appendChild(section);
  });
  sectionsWrap.replaceChildren(sectionsFrag);
}

function tagShowSkeleton(){
  const item = `<div class="tagpage-skel"><div class="tagpage-skel-cover"></div><div class="tagpage-skel-body"><div class="tagpage-skel-line short"></div><div class="tagpage-skel-line med"></div><div class="tagpage-skel-line"></div><div class="tagpage-skel-line short"></div></div></div>`;
  const wrap = document.getElementById('tagpageSections');
  const grid = document.createElement('div');
  grid.className = 'tagpage-grid';
  grid.innerHTML = item.repeat(8);
  wrap.replaceChildren(grid);
}

function tagShowEmpty(){
  document.getElementById('tagpageSections').innerHTML = `
    <div class="tagpage-message">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <div class="tagpage-message-title">Chưa có truyện nào</div>
      <div class="tagpage-message-sub">Thư viện đang trống, quay lại sau nhé.</div>
    </div>`;
}

function tagShowError(){
  document.getElementById('tagpageSections').innerHTML = `
    <div class="tagpage-message">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
      <div class="tagpage-message-title">Không thể tải dữ liệu</div>
      <div class="tagpage-message-sub">Vui lòng thử lại sau.</div>
    </div>`;
}

async function tagLoadNovels(){
  tagShowSkeleton();
  try{
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 8000);
    const res = await fetch('/api/novels', { signal: ctrl.signal, credentials: 'omit' });
    clearTimeout(timer);
    const data = await res.json();
    if(!data.ok || !Array.isArray(data.novels)) { tagShowError(); return; }

    const stories = data.novels.map(tagParseNovel).filter(Boolean);
    tagRenderSections(stories);
  }catch(err){
    console.warn('[PDS] tagLoadNovels:', err);
    tagShowError();
  }
}

document.addEventListener('DOMContentLoaded', tagLoadNovels);
</script>
</body>
