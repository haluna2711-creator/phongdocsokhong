.tagpage-btn-read{display:inline-flex;align-items:center;gap:6px;background:var(--gold-light);color:var(--black);border:none;padding:10px 20px;border-radius:24px;font-family:'Vollkorn',serif;font-size:11px;font-weight:700;letter-spacing:0.12em;cursor:pointer;transition:background var(--transition),transform var(--transition);text-decoration:none;white-space:nowrap}
.tagpage-btn-read:hover{background:var(--gold-hover);transform:scale(1.04)}

.tagpage-body{padding:14px 14px 16px;display:flex;flex-direction:column;gap:8px;flex:1}
.tagpage-title-txt{font-family:'Vollkorn',serif;font-size:14px;font-weight:700;color:var(--white);line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tagpage-desc-txt{font-size:12px;color:var(--text-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.tagpage-card-divider{width:30px;height:1px;background:var(--gold-border);margin:4px 0}
.tagpage-meta{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-muted)}
.tagpage-btn-row{margin-top:auto;padding-top:10px}
.tagpage-read-btn{display:flex;align-items:center;justify-content:center;gap:6px;width:100%;padding:9px 12px;background:transparent;border:1px solid var(--gold-border);border-radius:6px;color:var(--gold-light);font-family:'Vollkorn',serif;font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;transition:background var(--transition),border-color var(--transition),color var(--transition);text-decoration:none}
.tagpage-read-btn:hover{background:var(--gold-dim);border-color:var(--gold-light);color:var(--gold-hover)}

.tagpage-skel{background:var(--black-2);border:1px solid var(--gold-border);border-radius:8px;overflow:hidden}
.tagpage-skel-cover{width:100%;aspect-ratio:2/3;background:linear-gradient(90deg,var(--black-3) 25%,var(--black-4) 50%,var(--black-3) 75%);background-size:200% 100%;animation:tagpageShimmerSkel 1.5s infinite}
.tagpage-skel-body{padding:14px}
.tagpage-skel-line{height:10px;border-radius:4px;background:linear-gradient(90deg,var(--black-3) 25%,var(--black-4) 50%,var(--black-3) 75%);background-size:200% 100%;animation:tagpageShimmerSkel 1.5s infinite;margin-bottom:8px}
.tagpage-skel-line.short{width:55%}.tagpage-skel-line.med{width:80%}
@keyframes tagpageShimmerSkel{0%{background-position:200% 0}100%{background-position:-200% 0}}

.tagpage-message{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;gap:16px;text-align:center}
.tagpage-message svg{opacity:0.25}
