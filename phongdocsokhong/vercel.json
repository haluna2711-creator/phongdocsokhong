{
  "rewrites": [
    { "source": "/post/:slug", "destination": "/post.html" },
    { "source": "/p/:slug",    "destination": "/page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" }
      ]
    }
  ]
}
